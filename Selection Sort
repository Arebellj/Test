def selectionSort(arr):
	for i in range(0, len(arr) - 1):
		curMinIdx = i
		
		for j in range(i + 1, len(arr)):
			if arr[j] < arr[curMinIdx]:
				curMinIdx = j
				
				arr[i], arr[curMinIdx] = arr[curMinIdx], arr[i]


